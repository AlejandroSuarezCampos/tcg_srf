# Endurecimiento básico del servidor para este proyecto (no toca el php.ini global).

# ⚠️ LA PORTADA ES landing.php, NO index.php.
# Sin esta línea Apache busca index.php / index.html, no encuentra ninguno, y
# como el listado de directorios está desactivado responde
# "Forbidden. You don't have permission to access this resource" en la raíz
# del dominio — que es justo lo que pasaba en tcgfrontier.es. La regla de
# RewriteRule de más abajo hace lo mismo, pero solo si mod_rewrite está
# activo; DirectoryIndex no depende de ningún módulo, así que es la que de
# verdad sostiene la portada.
DirectoryIndex landing.php index.php index.html

# No listar el contenido de carpetas sin index (db/, db/pruebas/, assets/, branding/, .claude/...)
Options -Indexes

# Ruta desde la raíz del dominio. En producción el proyecto ES la raíz, así que
# es /404.php. (Apache no admite rutas relativas aquí: sin la barra inicial se
# toma como texto literal y se manda tal cual al navegador.)
ErrorDocument 404 /404.php
# Bloquea cualquier archivo dentro de .git/ (o cualquier otra carpeta oculta
# tipo .xxx). Sin esto, aunque el listado de directorio esté desactivado,
# .git/HEAD, .git/config, .git/index, etc. se pueden pedir uno a uno por su
# nombre exacto y reconstruir el repositorio entero con git-dumper.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\." - [F]

    # Si piden la raíz del sitio, servir landing.php sin cambiar la URL visible
    RewriteRule ^$ landing.php [L]
</IfModule>
# ============================================================================
# RENDIMIENTO
#
# Aquí no había NADA de esto, y era el motivo principal de que el sitio fuera
# lento: cada página se llevaba 269 KB de CSS propia SIN COMPRIMIR y sin una
# sola cabecera de caché, así que el navegador volvía a pedirlo todo en cada
# navegación. Comprimido son unos 40 KB, y con caché son cero a partir de la
# segunda página.
# ============================================================================

# ---- TIPOS MIME ----
# ⚠️ Sin esto, un Apache que no conozca `.woff2` lo sirve como
# `application/octet-stream`. Los navegadores modernos lo aceptan igual porque
# el `format("woff2")` del CSS manda, pero la regla `ExpiresByType font/woff2`
# de más abajo NO se aplicaría y las fuentes de iconos se revalidarían en cada
# navegación. Declararlo cuesta una línea.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType image/webp .webp
</IfModule>

# ---- COMPRESIÓN ----
# Solo texto: las imágenes (webp/png/jpg) y las fuentes woff2 ya vienen
# comprimidas y volver a pasarlas por gzip gasta CPU para no ganar nada.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
# Brotli si el servidor lo trae: comprime ~15 % mejor que gzip en texto.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>

# ---- CACHÉ DE ESTÁTICOS ----
#
# ⚠️ UN AÑO EN CSS Y JS NO ES UNA IMPRUDENCIA: `assetUrl()` (partials/assets.php)
#    les pega `?v=<filemtime>` a todos, así que al cambiar un fichero cambia su
#    URL y el navegador se lo baja igualmente. La caché larga solo afecta a lo
#    que NO ha cambiado, que es de lo que se trata.
#
#    El HTML se queda FUERA a propósito: es lo único que no lleva versión en la
#    URL, y cachearlo dejaría a la gente viendo una página vieja con monedas y
#    cartas que ya no son las suyas.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType text/javascript          "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType image/webp               "access plus 6 months"
    ExpiresByType image/png                "access plus 6 months"
    ExpiresByType image/jpeg               "access plus 6 months"
    ExpiresByType image/svg+xml            "access plus 6 months"
    ExpiresByType image/x-icon             "access plus 6 months"
    ExpiresDefault                         "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # `immutable` le ahorra al navegador hasta la petición de revalidación
    # cuando la persona recarga: sin él, un F5 manda un If-None-Match por cada
    # estático y se comen 30 viajes de ida y vuelta para recibir 30 "sigue
    # igual". Es seguro por lo mismo de arriba: la URL lleva la versión.
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpe?g|svg|ico)$">
        Header set Cache-Control "public, max-age=15552000"
    </FilesMatch>
    # El HTML nunca se guarda: lleva el saldo, el mazo y el estado del duelo.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag display_errors Off
</IfModule>
<IfModule php_module>
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag display_errors Off
</IfModule>